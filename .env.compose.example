# Settings for `docker compose` (copy to .env next to docker-compose.yml).
# Never commit the real .env — it is git-ignored.

# Public URL of the web app (used in notification links, CORS and cookies)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Long random value — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Behind HTTPS keep true. For a quick local trial over http://localhost you may set false.
COOKIE_SECURE=true

# SMS budget protection: daily cap on SMS codes and a Cloudflare Turnstile captcha
# (free; create a widget for the app domain at dash.cloudflare.com → Turnstile).
AUTH_SMS_DAILY_LIMIT=200
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push keys — generate with: npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:hello@talkclub.kz

# Database (not published outside the compose network; see docker-compose.yml to expose it locally)
POSTGRES_USER=talkclub
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=talkclub
POSTGRES_PORT=5433

# Web app is published on 127.0.0.1 only; the HTTPS reverse proxy on the host serves it publicly.
# Set WEB_BIND=0.0.0.0 only for a quick trial without a proxy.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# Interactive API docs (/api/docs) are off in production/staging; set true to enable temporarily.
API_DOCS_ENABLED=false

# Messaging providers: console | (your adapter). See docs/INTEGRATIONS.md
NOTIFY_EMAIL_PROVIDER=console
# Empty = mobizon when MOBIZON_API_KEY is set, otherwise console
NOTIFY_SMS_PROVIDER=
NOTIFY_WHATSAPP_PROVIDER=console
# Empty = telegram_bot when TELEGRAM_BOT_TOKEN is set, otherwise console
NOTIFY_TELEGRAM_PROVIDER=

# Mobizon SMS (see docs/INTEGRATIONS.md). Never paste the key into chats.
MOBIZON_API_KEY=
# Approved sender name; leave empty until Mobizon approves it
MOBIZON_FROM=

# Telegram bot for sign-in codes and notifications (see docs/INTEGRATIONS.md). Never paste the token into chats.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Talk_club_bot
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=

# Payments (Kaspi Pay credentials when the integration is enabled)
PAYMENT_MOCK_ONLINE_ENABLED=false
PAYMENT_WEBHOOK_SECRET=
KASPI_MERCHANT_ID=
KASPI_API_KEY=
