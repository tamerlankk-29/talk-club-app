# Settings for `docker compose` (copy to .env next to docker-compose.yml).
# Never commit the real .env — it is git-ignored.

# Public URL of the web app (used in notification links, CORS and cookies)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Long random value — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Behind HTTPS keep true. For a quick local trial over http://localhost you may set false.
COOKIE_SECURE=true

# Web Push keys — generate with: npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:hello@talkclub.kz

# Database (the container port is published on 5433 to avoid clashing with a local PostgreSQL)
POSTGRES_USER=talkclub
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=talkclub
POSTGRES_PORT=5433

# Messaging providers: console | (your adapter). See docs/INTEGRATIONS.md
NOTIFY_EMAIL_PROVIDER=console
NOTIFY_SMS_PROVIDER=console
NOTIFY_WHATSAPP_PROVIDER=console
NOTIFY_TELEGRAM_PROVIDER=console

# Payments (Kaspi Pay credentials when the integration is enabled)
PAYMENT_MOCK_ONLINE_ENABLED=false
PAYMENT_WEBHOOK_SECRET=
KASPI_MERCHANT_ID=
KASPI_API_KEY=
