# ─── Talk Club API configuration ───────────────────────────────────────────
# Copy to .env and adjust. Never commit real secrets — .env is git-ignored.

NODE_ENV=development
PORT=4000
# Public URL of the web app (used for links in notifications, CORS and cookies)
APP_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://talkclub:talkclub@localhost:5433/talkclub?schema=public
# Used by the integration test suite (it is wiped between test files)
TEST_DATABASE_URL=postgresql://talkclub:talkclub@localhost:5433/talkclub_test?schema=public

# ─── Authentication ───
# Long random string used to sign JWTs. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Development only: include the SMS verification code in the API response and log it.
# Must be false in staging/production.
AUTH_OTP_DEV_ECHO=true
# Set to true behind HTTPS so auth cookies get the Secure flag
COOKIE_SECURE=false

# ─── Push notifications (Web Push / VAPID) ───
# Generate a key pair: npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:hello@talkclub.kz

# ─── Messaging providers ───
# "console" logs messages instead of sending them. Real adapters implement
# ChannelProvider in src/modules/messaging/providers (see docs/INTEGRATIONS.md).
NOTIFY_EMAIL_PROVIDER=console
NOTIFY_SMS_PROVIDER=console
NOTIFY_WHATSAPP_PROVIDER=console
NOTIFY_TELEGRAM_PROVIDER=console
EMAIL_FROM="Talk Club <hello@talkclub.kz>"
SMS_API_KEY=
WHATSAPP_API_KEY=
TELEGRAM_BOT_TOKEN=

# ─── Payments ───
# Mock online checkout for development (never enable in production)
PAYMENT_MOCK_ONLINE_ENABLED=true
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
KASPI_MERCHANT_ID=
KASPI_API_KEY=

# ─── File storage ───
# "local" stores files on disk (development). See docs/INTEGRATIONS.md for object storage.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# ─── Background jobs (reminders, no-show processing, broadcasts, automations) ───
JOBS_ENABLED=true
