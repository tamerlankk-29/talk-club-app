# HTTPS in front of the web app. Caddy gets and renews the Let's Encrypt certificate itself;
# APP_DOMAIN and ACME_EMAIL come from .env (see scripts/server-setup.sh).
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	request_body {
		max_size 12MB
	}
	reverse_proxy web:3000
}
